--- !u!114 &817307275
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 817307271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c3a0aa25d40af449b5a8bd477d2ac0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _background: {fileID: 0}
  _cosmoController: {fileID: 0}
  _count: 0
  delay: 0.1
  saveText: 3.5
  _corutinStop: 0
  _request: 0
  saveTextBool: 0
  hint:
  - "\u0421\u043B\u0443\u0448\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E!
    \n\u0418\u0434\u0438 \u043F\u0440\u044F\u043C\u043E \u0438 \u043D\u0430\u0439\u0434\u0438
    \u0443\u0442\u0435\u0440\u044F\u043D\u044B\u0439 \u0431\u043E\u0442\u0438\u043D\u043E\u043A!"
  - "\u042D\u0442\u043E\u0442 \u0431\u043E\u0442\u0438\u043D\u043E\u043A \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
    \u041D\u0438\u043B\u0443 \u0410\u0440\u043C\u0441\u0442\u0440\u043E\u043D\u0433\u0443!\n\u041D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E!
    \u042D\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u043F\u043E\u0431\u044B\u0432\u0430\u0432\u0448\u0438\u0439 \u043D\u0430 \u043B\u0443\u043D\u0435!"
  - "\u0422\u0443\u0442 \u043D\u0438\u0437\u043A\u0430\u044F \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F!
    \u041F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0441\u0435\u0431\u044F
    \u0441\u0443\u043F\u0435\u0440\u0433\u0435\u0440\u043E\u0435\u043C \u0438 \u0437\u0430\u0431\u0435\u0440\u0438\u0441\u044C
    \u043D\u0430 \u0433\u043E\u0440\u0443 \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
    \u043F\u0440\u044B\u0436\u043A\u0430"
  - "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u0422\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F!"
  - "\u041D\u043E \u0431\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D,
    \u0442\u0443\u0442 \u0431\u044B\u0432\u0430\u044E\u0442 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u043D\u044B\u0435
    \u0434\u043E\u0436\u0434\u0438!"
  - "\u041B\u0443\u043D\u043D\u044B\u0435 \u043A\u0440\u0430\u0442\u0435\u0440\u044B
    \u2014 \u044D\u0442\u043E \u0447\u0430\u0448\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0435
    \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u0435\u0441\u044F
    \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
    \u041B\u0443\u043D\u044B \u0441 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u0430\u043C\u0438
    \u0438 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u0430\u043C\u0438"
  textComponent: {fileID: 748566856}
  colors:
  - {r: 1, g: 0, b: 0, a: 0}
  - {r: 0.4563539, g: 1, b: 0, a: 0}
  - {r: 1, g: 0.88970673, b: 0, a: 0}
